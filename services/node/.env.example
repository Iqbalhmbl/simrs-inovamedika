PORT=4000

# Read-only connection to the same Postgres database Yii2 writes to.
# Node only ever SELECTs from these tables (see src/db.js) - no business
# writes happen here, by design (see docs/architecture.md).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simrs
DB_USER=postgres
DB_PASSWORD=workingspace

# Must match Yii2's params.jwtSecret (config/params.php) - both backends
# validate the same JWT so a single login works across both APIs.
JWT_SECRET=dev-only-change-me-in-production-simrs-2026

# Base URL of the Yii2 API. Node forwards here for anything that is a
# business-logic write (e.g. a lab result coming from an external system),
# instead of writing to the database itself, to avoid duplicating business
# rules (requirement E.10).
YII_API_BASE_URL=http://localhost:8080
# Service-to-service JWT used when Node calls Yii on its own behalf (not on
# behalf of a logged-in user), e.g. for the external lab-integration push
# endpoint. Generate with: php yii auth/service-token (see commands/AuthController).
YII_SERVICE_TOKEN=
